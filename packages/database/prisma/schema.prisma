generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ MULTI-TENANT ============

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  plan        String   @default("free")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      WorkspaceMember[]
  campaigns    Campaign[]
  leads        Lead[]
  contacts     Contact[]
  integrations Integration[]
  apiKeys      ApiKey[]
  knowledgeSources KnowledgeSource[]
  knowledgeChunks  KnowledgeChunk[]
  aiRuns           AiRun[]
  styleProfile     StyleProfile?
  styleExamples    StyleExample[]
  marketingBrief   MarketingBrief?
  whatsappAccount  WhatsappAccount?
  emailAccount     EmailAccount?
  emailOptOuts     EmailOptOut[]
  outboundMessages OutboundMessage[]
  inboundMessages  InboundMessage[]
  messageOptOuts   MessageOptOut[]
  usageCounters    UsageCounter[]
  usageEvents      UsageEvent[]

  @@map("workspaces")
  messageAttachments MessageAttachment[]
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships WorkspaceMember[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

model WorkspaceMember {
  id          String   @id @default(cuid())
  role        String   @default("member")
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

// ============ CAMPAIGNS ============

model Campaign {
  id            String    @id @default(cuid())
  name          String
  description   String?
  industry      String
  location      String
  searchQueries String[]
  // Where leads are looked for, in order; later sources fill what earlier ones left of maxResults. google_maps | osm
  sources       String[]  @default(["google_maps"])
  maxResults    Int       @default(20)
  yourService   String
  contentStyle  String    @default("balanced")
  language      String    @default("indonesian")
  status        String    @default("draft")
  progress      Int       @default(0)
  error         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  totalLeads       Int   @default(0)
  priorityLeads    Int   @default(0)
  highQualityLeads Int   @default(0)
  averageScore     Float @default(0)

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  leads Lead[]

  @@map("campaigns")
}

// ============ LEADS ============

model Lead {
  id           String   @id @default(cuid())
  name         String
  address      String?
  lat          Float?
  lng          Float?
  phone        String?
  phoneE164    String? // digits with country code, used to match WhatsApp replies and opt-outs
  email        String?
  website      String?
  rating       String?
  reviewCount  Int?
  category     String?
  source       String   @default("google_maps")
  referenceUrl String?
  hasWebsite   Boolean  @default(false)

  score    Int    @default(0)
  priority String @default("LOW")
  aiAnalysis Json?

  marketingContent Json?

  // Contact details found on the business's own website (emails, WhatsApp numbers, social profiles) and when.
  enrichment Json?
  enrichedAt DateTime?

  crmStatus    String    @default("new")
  crmNotes     String?
  followUpDate DateTime?
  contactedAt  DateTime?
  repliedAt    DateTime?
  closedAt     DateTime?
  closeResult  String?

  // Following a lead to the close. dealValue is set when it is won; lostReason when it is lost.
  dealValue  Int?
  lostReason String? // not_interested | later | wrong_number | competitor | price | no_reply | other
  // They wrote and nobody has answered yet. Set by an incoming reply, cleared when a message goes out to them.
  needsReply Boolean @default(false)
  // What their latest reply meant: interested | meeting | question | later | not_interested | wrong_number | other
  lastIntent String?

  // Where the business is, from its coordinates (province, kabupaten/kota, kecamatan). geocodedAt is set even when nothing was found, so it is not asked again.
  province   String?
  regency    String?
  district   String?
  geocodedAt DateTime?

  // How far the contact data can be trusted. fieldMeta: where each field came from ({ phone: { source, at } }).
  // validation: free checks ({ waRegistered, emailMx, websiteLive, checkedAt }). dataQuality: high | medium | low, with the reasons in qualityIssues.
  fieldMeta     Json?
  validation    Json?
  dataQuality   String?
  qualityIssues String[] @default([])
  // open | temporarily_closed | permanently_closed, as the listing says. Null when unknown.
  businessStatus String?
  // The earlier lead (same business) this one repeats, found by phone, website domain or name and place.
  duplicateOfId String?
  duplicateOf   Lead?  @relation("LeadDuplicate", fields: [duplicateOfId], references: [id], onDelete: SetNull)
  duplicates    Lead[] @relation("LeadDuplicate")

  scrapedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId  String
  contact     Contact?  @relation(fields: [contactId], references: [id])
  contactId   String?

  activities LeadActivity[]
  followUps  FollowUp[]
  outbound   OutboundMessage[]
  inbound    InboundMessage[]

  @@index([workspaceId, phoneE164])
  @@index([workspaceId, needsReply])
  @@index([workspaceId, province, regency])
  @@index([workspaceId, duplicateOfId])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(cuid())
  type      String
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  @@map("lead_activities")
}

model FollowUp {
  id          String    @id @default(cuid())
  scheduledAt DateTime
  note        String?
  done        Boolean   @default(false)
  doneAt      DateTime?
  createdAt   DateTime  @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId String

  @@map("follow_ups")
}

// ============ CONTACTS ============

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  position  String?
  website   String?
  address   String?
  tags      String[]
  notes     String?
  source    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  leads Lead[]

  @@map("contacts")
}

// ============ INTEGRATIONS ============

model Integration {
  id          String   @id @default(cuid())
  type        String
  name        String
  config      Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@map("integrations")
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique   // SHA-256 hash of the key; plaintext is shown only once at creation
  keyPrefix  String              // First 8 chars of key for display (e.g. "px_abc123")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@map("api_keys")
}

// ============ AI: KNOWLEDGE (RAG) ============
// Embeddings use pgvector. The column is an unconstrained `vector` so any
// embedding model works; every chunk records which model/dimension produced
// it and searches only compare chunks of the same model and dimension.

model KnowledgeSource {
  id          String   @id @default(cuid())
  title       String
  kind        String   @default("text") // text | faq | catalog | document | url | file
  url         String? // set when the source was fetched from a web page
  text        String? // the extracted text, kept so a brief can be regenerated and the source can be shown back to the user
  status      String   @default("ready") // processing | ready | failed
  error       String?
  chunkCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  chunks      KnowledgeChunk[]

  @@index([workspaceId])
  @@map("knowledge_sources")
}

model KnowledgeChunk {
  id             String   @id @default(cuid())
  content        String
  position       Int
  embeddingModel String
  dimensions     Int
  embedding      Unsupported("vector")?
  createdAt      DateTime @default(now())

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  source      KnowledgeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId    String

  @@index([workspaceId, embeddingModel])
  @@map("knowledge_chunks")
}

// One row per AI generation, for debugging and quality review.
model AiRun {
  id         String   @id @default(cuid())
  kind       String   // draft | search | agent
  model      String?
  input      String?
  output     String?
  sourceIds  String[]
  confidence String?  // high | low | none
  latencyMs  Int?
  error      String?
  createdAt  DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId, createdAt])
  @@map("ai_runs")
}

// ============ AI: WRITING STYLE ============
// Built from the owner's own WhatsApp chat exports. Raw chats are never stored:
// only measured statistics and anonymized (incoming -> reply) example pairs.

model StyleProfile {
  id             String   @id @default(cuid())
  ownerName      String
  stats          Json
  messageCount   Int
  exampleCount   Int
  embeddingModel String
  dimensions     Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @unique
  examples    StyleExample[]

  @@map("style_profiles")
}

model StyleExample {
  id             String   @id @default(cuid())
  incoming       String
  reply          String
  embeddingModel String
  dimensions     Int
  embedding      Unsupported("vector")?
  createdAt      DateTime @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  profile     StyleProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String

  @@index([workspaceId, embeddingModel])
  @@map("style_examples")
}


// ============ MESSAGING: APPROVAL QUEUE + WHATSAPP ============
// Every outgoing message starts as a draft. Nothing is sent until a person approves it.

model WhatsappAccount {
  id                 String   @id @default(cuid())
  provider           String   @default("baileys") // baileys | cloud_api (official API, planned)
  status             String   @default("disconnected") // disconnected | connecting | qr | connected | logged_out
  phone              String?
  hourlyLimit        Int      @default(10)
  dailyLimit         Int      @default(80)
  quietStartHour     Int      @default(21)
  quietEndHour       Int      @default(7)
  timezone           String   @default("Asia/Jakarta")
  defaultCountryCode String   @default("62")
  paused             Boolean  @default(false)
  nextSendAt         DateTime?
  lastError          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @unique

  @@map("whatsapp_accounts")
}

model OutboundMessage {
  id                String    @id @default(cuid())
  channel           String    @default("whatsapp") // whatsapp | email
  toPhone           String    @default("") // empty for email
  toEmail           String? // email channel only
  subject           String? // email channel only
  body              String
  aiBody            String? // what the model wrote, kept to measure how much people edit
  source            String // ai_outreach | ai_reply | ai_followup | manual
  status            String    @default("draft") // draft | approved | sending | sent | failed | rejected | cancelled
  context           Json?
  editedByUser      Boolean   @default(false)
  attempts          Int       @default(0)
  error             String?
  providerMessageId String?
  approvedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // WhatsApp only: a file sent with the text as its caption, and the card shown for a link in the text.
  attachment   MessageAttachment? @relation(fields: [attachmentId], references: [id], onDelete: Restrict)
  attachmentId String?
  linkPreview  Json? // { url, title, description, thumbnail (base64 JPEG, optional) }

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?

  @@index([workspaceId, status, createdAt])
  @@index([attachmentId])
  @@index([workspaceId, sentAt])
  @@index([leadId])
  @@map("outbound_messages")
}

// SMTP sending account of a workspace (email channel). The password is encrypted at rest.
model EmailAccount {
  id            String    @id @default(cuid())
  host          String
  port          Int       @default(587)
  secure        Boolean   @default(false) // true = implicit TLS (port 465), false = STARTTLS
  username      String
  passwordEnc   String
  fromName      String
  fromEmail     String
  replyTo       String?
  postalAddress String // printed in every message, required by anti-spam laws in many countries
  ctaUrl        String? // one link added to the first email, written by the owner (never invented by the model)
  hourlyLimit   Int       @default(8)
  dailyLimit    Int       @default(40)
  quietStartHour Int      @default(20)
  quietEndHour  Int       @default(7)
  timezone      String    @default("Asia/Jakarta")
  paused        Boolean   @default(false)
  status        String    @default("untested") // untested | ready | error
  lastError     String?
  verifiedAt    DateTime?
  nextSendAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @unique

  @@map("email_accounts")
}

model EmailOptOut {
  id        String   @id @default(cuid())
  email     String // lower case
  reason    String?
  createdAt DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([workspaceId, email])
  @@map("email_opt_outs")
}

model InboundMessage {
  id                String   @id @default(cuid())
  fromPhone         String
  body              String
  providerMessageId String
  receivedAt        DateTime @default(now())
  intent            String? // what this message meant, see Lead.lastIntent

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  lead        Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId      String?

  @@unique([workspaceId, providerMessageId])
  @@index([workspaceId, fromPhone, receivedAt])
  @@map("inbound_messages")
}

model MessageOptOut {
  id        String   @id @default(cuid())
  phone     String
  reason    String?
  createdAt DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([workspaceId, phone])
  @@map("message_opt_outs")
}


// ============ MARKETING BRIEF ============
// The workspace's product-marketing context (what is sold, to whom, why it wins, what is proven).
// Generated from the user's own sources and reviewed by them; every other marketing module reads it.

model MarketingBrief {
  id        String   @id @default(cuid())
  version   Int      @default(1)
  language  String   @default("indonesian")
  summary   String // short service/product description used to fill campaigns
  content   Json // structured sections, see apps/api/src/marketing/brief-schema.ts
  sourceIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String    @unique

  @@map("marketing_briefs")
}


// ============ USAGE METERING ============
// Counters and per-call AI usage. Useful to any install (self-hosters can see what their AI key costs). Plans,
// subscriptions and payments are NOT here: they live in a separate commercial package with its own tables.

/** Monthly counters per workspace (period = "YYYY-MM"). Limits sum the counters of every workspace the owner has. */
model UsageCounter {
  id          String   @id @default(cuid())
  period      String
  metric      String // draft | scrape | message_sent
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@unique([workspaceId, period, metric])
  @@map("usage_counters")
}

/** One row per AI call: tokens and model, so cost per draft can be measured before prices and limits are locked. */
model UsageEvent {
  id               String   @id @default(cuid())
  kind             String // ai_chat | ai_embed
  model            String?
  source           String? // workspace | server
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  createdAt        DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String

  @@index([workspaceId, createdAt])
  @@map("usage_events")
}

/// Install-wide settings that belong to no workspace (instance id, licence key and the last signed licence document).
model InstanceSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("instance_settings")
}

/// A file the owner uploaded to send over WhatsApp (brochure, price list, photo). Reused by many messages.
model MessageAttachment {
  id          String   @id @default(cuid())
  fileName    String
  mimeType    String
  sizeBytes   Int
  storageKey  String   @unique // file name on disk; never taken from the client
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  workspaceId String
  messages    OutboundMessage[]

  @@index([workspaceId, createdAt])
  @@map("message_attachments")
}
