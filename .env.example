# ============================================================
# Prospex — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ── Required ─────────────────────────────────────────────────

# Database (PostgreSQL)
DATABASE_URL="postgresql://prospex:yourpassword@localhost:5432/prospex"

# JWT signing secret — min 16 chars, use: openssl rand -base64 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# AES-256-GCM key used to encrypt integration secrets (e.g. OpenAI keys) at rest — 32 random bytes, base64, use: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-base64-encoded-32-byte-key

# ── Database container (used by docker-compose) ───────────────
POSTGRES_USER=prospex
POSTGRES_PASSWORD=yourpassword
POSTGRES_DB=prospex

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
# For production (set in docker-compose.prod.yml):
# REDIS_PASSWORD=changeme
# REDIS_URL="redis://:changeme@localhost:6379"

# ── AI Provider ───────────────────────────────────────────────
# OpenAI, OpenRouter, Ollama, or any OpenAI-compatible provider
# Leave empty to turn the AI features off (drafts, AI Style, knowledge base).
# Scraping and rule-based scoring still work. Prospex never fills the gap with canned text.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional, for reasoning models only (e.g. Ollama gemma4/qwen3): "none" turns off the thinking phase, which is
# much faster for writing and JSON tasks. Leave empty for models that do not support it (e.g. gpt-4o-mini).
# OPENAI_REASONING_EFFORT=none
# Embedding model for the knowledge base (RAG). Changing it later means re-indexing sources.
EMBEDDING_MODEL=text-embedding-3-small
# Uncomment to use alternative providers:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# ── Scraper ───────────────────────────────────────────────────
# "live" scrapes Google Maps with a headless Chromium (install it once:
#   pnpm --filter @prospex/api exec playwright install chromium).
# "fixture" returns clearly labelled test leads without phone numbers. Tests and demos only: never invented businesses in real use.
# SCRAPER_MODE=live

# ── WhatsApp ──────────────────────────────────────────────────
# Where linked-device sessions are stored (treat like a password; use a persistent volume in production)
# WA_AUTH_DIR=./.wa-auth
# Set to "true" to disable the sender, WhatsApp connections and follow-up scheduling (e.g. in CI)
# WHATSAPP_DISABLED=false

# ── Marketing brief and site reading ─────────────────────────
# Characters of source text read per pass of the Marketing Brief (about 4 characters per token). Lower it for small-context models.
# BRIEF_SOURCE_CHARS=30000
# Chromium's sandbox stays on unless this is "true". Only containers that cannot create the sandbox need it (the Docker image sets it).
# PLAYWRIGHT_NO_SANDBOX=true

# ── App URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ── Server ────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Production only ───────────────────────────────────────────
# APP_URL=https://yourdomain.com
# API_URL=https://yourdomain.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Edition: community (open source, default) or hosted (alatpintar.id). See docs/editions.md
EDITION=community
# On a hosted server a workspace may only set a public https AI base URL. Set true to also allow private addresses.
# AI_ALLOW_PRIVATE_BASE_URL=true
# Private official WhatsApp connector, hosted only. Leave empty otherwise.
WHATSAPP_CLOUD_PLUGIN=

# Email channel (see docs/email-channel.md)
# Public base URL of the API, used in unsubscribe links, e.g. https://api.example.com/api
PUBLIC_API_URL=
# EMAIL_DISABLED=true
# EMAIL_ALLOW_PRIVATE_SMTP=true
